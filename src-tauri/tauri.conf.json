{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickBox",
  "version": "0.1.0",
  "identifier": "com.quickbox.app",
  "build": {
    "beforeDevCommand": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-vite.ps1",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "QuickBox",
        "width": 960,
        "height": 620,
        "minWidth": 820,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "resizable": true,
        "visible": true,
        "skipTaskbar": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
