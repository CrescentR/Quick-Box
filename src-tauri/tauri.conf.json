{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickBox",
  "version": "0.1.0",
  "identifier": "com.quickbox.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "QuickBox",
        "width": 900,
        "height": 560,
        "center": true,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
