{
  "name": "quickbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "tauri:dev:attach": "node scripts/tauri-run.cjs dev --config src-tauri/tauri.dev.json",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/ensure-deps.cjs",
    "build": "tsc && vite build",
    "check:rust": "cd src-tauri && cargo check",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm check:rust",
    "preview": "vite preview",
    "tauri": "node scripts/tauri-run.cjs",
    "tauri:dev": "node scripts/tauri-run.cjs dev",
    "tauri:build": "node scripts/tauri-run.cjs build",
    "tauri:build:mac": "node scripts/tauri-run.cjs build --bundles app,dmg",
    "tauri:build:mac:universal": "node scripts/tauri-run.cjs build --target universal-apple-darwin --bundles app,dmg",
    "tauri:build:win": "node scripts/tauri-run.cjs build --bundles nsis,msi",
    "tauri:build:linux": "node scripts/tauri-run.cjs build --bundles appimage,deb",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:linux-commands": "node scripts/sync-linux-commands.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.16.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-diff-viewer-continued": "^4.2.2",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@9.15.4"
}
