{
  "name": "quickbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "tauri:dev:attach": "node scripts/tauri-run.cjs dev --config src-tauri/tauri.dev.json",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "check:rust": "cd src-tauri && cargo check",
    "verify": "pnpm typecheck && pnpm build && pnpm check:rust",
    "preview": "vite preview",
    "tauri": "node scripts/tauri-run.cjs",
    "tauri:dev": "node scripts/tauri-run.cjs dev",
    "tauri:build": "node scripts/tauri-run.cjs build",
    "tauri:build:mac": "node scripts/tauri-run.cjs build --bundles app,dmg",
    "tauri:build:mac:universal": "node scripts/tauri-run.cjs build --target universal-apple-darwin --bundles app,dmg",
    "tauri:build:win": "node scripts/tauri-run.cjs build --bundles nsis,msi",
    "tauri:build:linux": "node scripts/tauri-run.cjs build --bundles appimage,deb"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "packageManager": "pnpm@9.15.4"
}
